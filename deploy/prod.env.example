# Production environment for deploy/docker-compose.prod.yml.
# Copy to deploy/prod.env (gitignored) and fill in real values on the server.

# Public hostname. Caddy issues the TLS certificate for this name.
DOMAIN=8kount.app

# Postgres. Pick a long random password:  openssl rand -base64 32
POSTGRES_USER=camerasync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knighthyve

# Recording storage (SCRUM-63 / SCRUM-102). Run  bash deploy/provision-s3.sh
# from an admin machine; it creates the bucket and an IAM user and prints these
# lines. Leave them commented out to keep recordings on the instance disk.
# STORAGE_DRIVER=s3
# S3_BUCKET=8kount-recordings-123456789012
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
