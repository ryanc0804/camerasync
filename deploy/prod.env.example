# Production environment for deploy/docker-compose.prod.yml.
# Copy to deploy/prod.env (gitignored) and fill in real values on the server.

# Public hostname. Caddy issues the TLS certificate for this name.
DOMAIN=8kount.app

# Postgres. Pick a long random password:  openssl rand -base64 32
POSTGRES_USER=camerasync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knighthyve

# Email (sign-up confirmation + password reset). Without SMTP_HOST, codes
# only reach the server log and nobody can confirm a new account. Resend is
# set up for 8kount.app (verified sending domain); the key is the
# "8kount-server" API key in the Resend dashboard (shown once, so ask whoever
# created it, or make a new Sending-access key).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=
# EMAIL_FROM="8kount <no-reply@8kount.app>"
# Who may sign up; defaults to ucf.edu,knights.ucf.edu when unset.
# ALLOWED_EMAIL_DOMAINS=ucf.edu,knights.ucf.edu
# Exact addresses that may sign up from any domain (e.g. the team's admin
# account); everyone else still needs an allowed domain.
# ALLOWED_EMAILS=

# Recording storage (SCRUM-63 / SCRUM-102). Run  bash deploy/provision-s3.sh
# from an admin machine; it creates the bucket and an IAM user and prints these
# lines. Leave them commented out to keep recordings on the instance disk.
# STORAGE_DRIVER=s3
# S3_BUCKET=8kount-recordings-123456789012
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
