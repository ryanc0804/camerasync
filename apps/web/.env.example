# URL of the Camera Sync server (Express + Socket.IO).
# Leave it unset to talk to port 4000 on whatever host served the page, which
# is what you want for testing several devices over the LAN. A localhost value
# is rewritten to the page's host on non-localhost devices (see
# src/api/serverUrl.js).
VITE_SERVER_URL=http://localhost:4000

# Port used when VITE_SERVER_URL is unset.
# VITE_SERVER_PORT=4000
