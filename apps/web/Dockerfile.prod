# Production image for the web app: build the React bundle, then serve it
# with Caddy (which also terminates TLS and proxies the API; see deploy/Caddyfile).

FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_SERVER_URL
ENV VITE_SERVER_URL=${VITE_SERVER_URL}
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
