# Server
PORT=4000

# CORS origin for the web app (Vite default). Accepts a comma-separated list.
# Outside production, loopback and LAN origins are allowed automatically so
# phones on the same Wi-Fi can connect (see src/middleware/cors.js).
WEB_ORIGIN=http://localhost:5173

# Where uploaded media is written (defaults to apps/server/uploads)
# UPLOAD_DIR=

# Environment: "development" uses the local docker Postgres (DATABASE_URL);
# "production" uses AWS RDS (RDS_* below). See src/db/pool.js.
NODE_ENV=development

# Development Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://camerasync:camerasync@localhost:5432/knighthyve

# Production Postgres (AWS RDS) - only read when NODE_ENV=production
# RDS_HOST=your-instance.xxxxxxxx.us-east-1.rds.amazonaws.com
# RDS_PORT=5432
# RDS_USER=
# RDS_PASSWORD=
# RDS_DB=
# Optional: path to the AWS RDS CA bundle (global-bundle.pem) to verify TLS
# RDS_SSL_CA=
# RDS_POOL_MAX=10

# S3 media storage - only used when NODE_ENV=production (development keeps
# writing to UPLOAD_DIR). Uploads are staged in the OS temp dir, then sent to S3.
# S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# Optional key prefix inside the bucket, e.g. uploads
# S3_PREFIX=
# Optional: omit on EC2 to use the instance role via the default credential chain
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
