# Server
PORT=4000

# CORS origin for the web app (Vite default)
WEB_ORIGIN=http://localhost:5173

# Where uploaded media is written (defaults to apps/server/uploads). With the
# S3 driver this only holds uploads while they are being validated.
# UPLOAD_DIR=

# Recording storage: "local" (default) keeps files under UPLOAD_DIR; "s3"
# stores them in a bucket. Leaving STORAGE_DRIVER unset picks s3 whenever
# S3_BUCKET is set. See src/storage/index.js.
# STORAGE_DRIVER=local
# S3_BUCKET=8kount-recordings
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_KEY_PREFIX=recordings/
#
# To test the S3 driver locally, point it at any S3-compatible store (MinIO,
# s3rver, ...) with path-style addressing:
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=camerasync
# AWS_ACCESS_KEY_ID=S3RVER
# AWS_SECRET_ACCESS_KEY=S3RVER

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://camerasync:camerasync@localhost:5432/knighthyve

# Outgoing email (password reset codes/links). Any SMTP provider works —
# Brevo and Resend have free tiers that cover this app's volume. Leave
# SMTP_HOST unset to skip sending and log the code/link to the console
# instead (fine for local dev). SMTP_SECURE=true means implicit TLS
# (usually port 465); the default 587 upgrades via STARTTLS.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM="8kount <no-reply@yourdomain.com>"
